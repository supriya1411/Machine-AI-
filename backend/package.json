{
  "name": "aurum-backend",
  "version": "1.0.0",
  "description": "AURUM Service Intelligence NestJS Backend with NASA C-MAPSS and AI4I 2020 Integration",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.13",
    "@prisma/client": "^6.4.1",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "csv-parse": "^6.1.1",
    "dotenv": "^17.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
