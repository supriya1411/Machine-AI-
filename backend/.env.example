PROJECT_NAME="AURUM Service Intelligence API"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000

# Database Configuration
# Local SQLite Dev fallback:
DATABASE_URL="file:/app/applet/backend/prisma/dev.db"

# PostgreSQL Production / Docker Database URL:
# DATABASE_URL="postgresql://aurum_user:aurum_password@postgres:5432/aurum_db"

# Security & JWT Authentication
JWT_SECRET="aurum-service-intelligence-production-super-secret-key-2026"
JWT_EXPIRES_IN="24h"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# AI Assistant Grounding (Optional Google Gemini API Key)
GEMINI_API_KEY=""
AI_API_KEY=""

# Background Telemetry & WebSocket Settings
ENABLE_BACKGROUND_SIMULATION=true
TELEMETRY_INTERVAL_MS=5000
