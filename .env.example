# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# FRONTEND_URL: Allowed CORS origin for the Antigravity frontend
FRONTEND_URL="http://localhost:5173"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://aurum_user:aurum_password@localhost:5432/aurum_db"

# JWT_SECRET: Secret key for signing and verifying JWT tokens
JWT_SECRET="aurum-service-intelligence-production-super-secret-key-2026"

# ENVIRONMENT & LOGGING
ENVIRONMENT="development"
LOG_LEVEL="INFO"
