// AURUM Service Intelligence - Normalized Relational Schema for PostgreSQL
// Integrates NASA C-MAPSS (FD001-FD004) and AI4I 2020 Predictive Maintenance datasets

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Site {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  address       String?
  city          String?
  state         String?
  country       String?
  latitude      Float?
  longitude     Float?
  status        String   @default("ACTIVE")
  isSynthetic   Boolean  @default(true)
  sourceDataset String   @default("SYNTHETIC")
  assets        Asset[]
  users         User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String?  // JSON stringified permissions
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  phone              String?
  passwordHash       String
  roleId             String?
  role               Role?          @relation(fields: [roleId], references: [id])
  roleName           String?
  status             String         @default("ACTIVE")
  siteId             String?
  site               Site?          @relation(fields: [siteId], references: [id])
  isSynthetic        Boolean        @default(true)
  sourceDataset      String         @default("SYNTHETIC")
  faultsResolved     FaultRecord[]
  maintenances       Maintenance[]
  workOrders         WorkOrder[]
  alertsAcknowledged Alert[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Asset {
  id                 String                @id @default(uuid())
  assetId            String                @unique // e.g. "EQ-CMAPSS-FD001-001", "EQ-AI4I-M14860", "EQ-102"
  name               String
  category           String                // "Turbofan Engine", "CNC Milling Machine", "Centrifugal Chiller", etc.
  model              String?
  serialNumber       String?               @unique
  manufacturer       String?
  siteId             String?
  site               Site?                 @relation(fields: [siteId], references: [id])
  floor              String?
  installationDate   DateTime?
  warrantyExpiry     DateTime?
  criticality        String                @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status             String                @default("OPERATIONAL") // "OPERATIONAL", "DEGRADED", "DOWN", "MAINTENANCE"
  healthScore        Float                 @default(100.0)
  riskScore          Float                 @default(0.0)
  riskLevel          String                @default("LOW") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  lastRiskAssessment DateTime?
  rul                Float?                // Remaining Useful Life in cycles/hours
  sourceDataset      String                // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId     String?               // Original unit or UDI identifier
  metadata           String?               // JSON stringified additional data
  sensors            SensorDevice[]
  sensorReadings     SensorReading[]
  faults             FaultRecord[]
  anomalies          SensorAnomaly[]
  healthHistories    HealthScoreHistory[]
  maintenances       Maintenance[]
  workOrders         WorkOrder[]
  contractAssets     ContractAsset[]
  alerts             Alert[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([category])
  @@index([status])
  @@index([riskLevel])
  @@index([sourceDataset])
}

model FaultCategory {
  id            String        @id @default(uuid())
  code          String        @unique // "OVERHEATING", "TOOL_WEAR", "HEAT_DISSIPATION", "POWER_FAILURE", etc.
  name          String
  severity      String        @default("MEDIUM")
  description   String?
  keywords      String?       // JSON stringified keywords for taxonomy mapping
  sourceDataset String        @default("TAXONOMY")
  faults        FaultRecord[]
  createdAt     DateTime      @default(now())
}

model FaultRecord {
  id                 String         @id @default(uuid())
  assetId            String
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date               DateTime
  rawFault           String
  normalizedFaultId  String?
  faultCategory      FaultCategory? @relation(fields: [normalizedFaultId], references: [id])
  faultCode          String?
  severity           String         @default("MEDIUM")
  description        String?
  resolution         String?
  engineerId         String?
  engineer           User?          @relation(fields: [engineerId], references: [id])
  downtime           Float          @default(0.0) // downtime in hours
  failureType        String?        // "TWF", "HDF", "PWF", "OSF", "RNF", "HPC_DEGRADATION", etc.
  sourceDataset      String         // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId     String?
  isSynthetic        Boolean        @default(false)
  evidenceDetail     String?        // JSON stringified evidence
  createdAt          DateTime       @default(now())

  @@index([assetId])
  @@index([faultCode])
  @@index([date])
}

model SensorDevice {
  id             String          @id @default(uuid())
  assetId        String
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceId       String          @unique // e.g. "SENS-TEMP-EQ-102", "SENS-CMAPSS-FD001-001-s2"
  sensorType     String          // "temperature", "pressure", "vibration", "speed", "torque", "tool_wear"
  name           String
  unit           String          // "°C", "K", "rpm", "Nm", "min", "psi", "bar", etc.
  status         String          @default("ONLINE") // "ONLINE", "OFFLINE", "DELAYED", "STALE"
  lastSeen       DateTime?
  safeMin        Float?
  safeMax        Float?
  warningMin     Float?
  warningMax     Float?
  criticalMin    Float?
  criticalMax    Float?
  configuration  String?         // JSON stringified
  sourceDataset  String          // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId String?
  readings       SensorReading[]
  anomalies      SensorAnomaly[]
  alerts         Alert[]
  createdAt      DateTime        @default(now())

  @@index([assetId])
  @@index([sensorType])
  @@index([status])
}

model SensorReading {
  id             String       @id @default(uuid())
  sensorId       String
  sensor         SensorDevice @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp      DateTime
  cycle          Int?         // C-MAPSS engine flight cycle
  value          Float
  unit           String
  setting1       Float?       // Operational setting 1 (altitude/speed)
  setting2       Float?       // Operational setting 2 (mach number)
  setting3       Float?       // Operational setting 3 (TRA)
  sourceDataset  String       // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId String?

  @@index([sensorId, timestamp])
  @@index([assetId, cycle])
}

model SensorAnomaly {
  id                String       @id @default(uuid())
  sensorId          String
  sensor            SensorDevice @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp         DateTime
  severity          String       // "WARNING" | "HIGH" | "CRITICAL"
  value             Float
  thresholdBreached String
  durationMinutes   Float        @default(0.0)
  resolved          String       @default("FALSE")
  sourceDataset     String       // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId    String?
  evidenceDetail    String?      // JSON stringified
  createdAt         DateTime     @default(now())

  @@index([assetId])
  @@index([sensorId])
  @@index([timestamp])
}

model HealthScoreHistory {
  id                 String   @id @default(uuid())
  assetId            String
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  healthScore        Float
  riskScore          Float
  riskLevel          String   // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  factors            String?  // JSON stringified factors
  recommendedActions String?  // JSON stringified recommendations
  rul                Float?   // Remaining Useful Life
  sourceDataset      String   // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId     String?
  calculatedAt       DateTime @default(now())

  @@index([assetId, calculatedAt])
}

model Contract {
  id               String          @id @default(uuid())
  contractId       String          @unique // e.g. "AMC-2024-001"
  name             String
  customer         String
  vendor           String?
  type             String          // "AMC" | "CMC"
  startDate        DateTime
  endDate          DateTime
  value            Float           @default(0.0)
  pmFrequencyDays  Int             @default(90)
  status           String          @default("ACTIVE") // "ACTIVE", "EXPIRING_SOON", "EXPIRED"
  complianceScore  Float           @default(100.0)
  renewalRisk      String          @default("LOW") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  isSynthetic      Boolean         @default(true)
  sourceDataset    String          @default("SYNTHETIC")
  contractAssets   ContractAsset[]
  maintenances     Maintenance[]
  alerts           Alert[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([renewalRisk])
}

model ContractAsset {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  isSynthetic Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([contractId, assetId])
}

model Maintenance {
  id            String    @id @default(uuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  contractId    String?
  contract      Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  pmType        String
  scheduledDate DateTime
  completedDate DateTime?
  status        String    @default("SCHEDULED") // "SCHEDULED", "COMPLETED", "OVERDUE", "MISSED"
  engineerId    String?
  engineer      User?     @relation(fields: [engineerId], references: [id], onDelete: SetNull)
  cadenceDays   Int       @default(90)
  notes         String?
  isSynthetic   Boolean   @default(true)
  sourceDataset String    @default("SYNTHETIC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([scheduledDate])
}

model WorkOrder {
  id                 String    @id @default(uuid())
  assetId            String
  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type               String    @default("CORRECTIVE") // "PREVENTIVE", "CORRECTIVE", "EMERGENCY"
  priority           String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  assignedEngineerId String?
  assignedEngineer   User?     @relation(fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  dueDate            DateTime?
  completedAt        DateTime?
  status             String    @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  description        String?
  isSynthetic        Boolean   @default(true)
  sourceDataset      String    @default("SYNTHETIC")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([priority])
}

model Alert {
  id                String        @id @default(uuid())
  type              String        // "ENVIRONMENTAL_IOT", "OVERDUE_PM", "CONTRACT_EXPIRY", "FAULT_PREDICTION"
  severity          String        @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  assetId           String?
  asset             Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  sensorId          String?
  sensor            SensorDevice? @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  contractId        String?
  contract          Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  title             String
  message           String?
  currentValue      String?
  threshold         String?
  duration          String?
  reason            String?
  recommendedAction String?
  status            String        @default("ACTIVE") // "ACTIVE", "ACKNOWLEDGED", "RESOLVED"
  sourceDataset     String        // "CMAPSS" | "AI4I_2020" | "SYNTHETIC"
  sourceRecordId    String?
  sourceEvidence    String?       // JSON stringified evidence
  isSynthetic       Boolean       @default(false)
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  acknowledgedUser  User?         @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([assetId])
  @@index([status])
  @@index([severity])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    String?  // JSON stringified
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}
